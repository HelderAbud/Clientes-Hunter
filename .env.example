# Variáveis de ambiente — Clientes Hunter
# Copie para .env e preencha SOMENTE quando usar automação (Fase 2+).
# Nunca commite o arquivo .env

# --- Fase 2 opcional: Telegram (alertas) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Fase 6 opcional: Evolution API (WhatsApp semi-auto) ---
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=

# --- Fase 3+: app / banco ---
# DATABASE_URL=
# JWT_SECRET=
