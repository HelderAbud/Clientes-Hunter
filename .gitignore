# Clientes Hunter — dados sensíveis (não commitar)

# Rascunhos locais (notas pessoais, prompts)
Novo Documento de Texto.md.txt
*-rascunho*
*-draft*

# Base de clientes existentes (CNPJ, razão social)
data/clientes-existentes.csv
data/_pdf_raw.txt
data/backups/
data/*.pdf

# Exports reais (Places, planilha, candidatos) — pasta local apenas
# README da pasta pode ser versionado; CSVs reais não
data/exports/*
!data/exports/README.md

# PDFs e exports em qualquer pasta do projeto
*.pdf
Clientes_*.pdf

# Secrets (Places API, Telegram, Evolution, etc.)
.env
.env.*
!.env.example

# Planilhas / CSV com telefones reais (exports locais)
*-leads-export.csv
*-leads-export.xlsx
Clientes-Hunter-Leads*.csv
Clientes-Hunter-Leads*.xlsx
*candidatos*.csv
!**/Candidatos.example.csv
!**/Candidatos-entrada.example.csv
places-out/
**/places-out/

# Sessões / credenciais
*cookies*
*instagram*session*
*.pem
*.key

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# Imagens locais / screenshots pessoais (não versionar)
WhatsApp Image*.jpeg
WhatsApp Image*.jpg
screenshots-local/

# Python cache (se usar scripts locais)
__pycache__/
*.pyc
.venv/
